        </entry>
        <entry>
          <string>Label</string>
          <string>storealign</string>
        </entry>
        <entry>
          <string>externalInputs</string>
          <string>funct3:3,addr:2,rs2_data:32</string>
        </entry>
        <entry>
          <string>Width</string>
          <int>10</int>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>byte_en:4,write_data:32</string>
        </entry>
        <entry>
          <string>Code</string>
          <string>module storealign (
  input  logic [2:0]  funct3,      // 000: sb, 001: sh, 010: sw
  input  logic [1:0]  addr,        // dos bits bajos de la dirección
  input  logic [31:0] rs2_data,
  output logic [31:0] write_data,
  output logic [3:0]  byte_en
);

  always_comb begin
    case (funct3[1:0])
      2&apos;b00: begin   // sb
        write_data = {4{rs2_data[7:0]}};
        byte_en    = 4&apos;b0001 &lt;&lt; addr;
      end
      2&apos;b01: begin   // sh (addr[0] se ignora: accesos no alineados no soportados)
        write_data = {2{rs2_data[15:0]}};
        byte_en    = addr[1] ? 4&apos;b1100 : 4&apos;b0011;
      end
      default: begin // sw
        write_data = rs2_data;
        byte_en    = 4&apos;b1111;
      end
    endcase
  end
endmodule</string>
        </entry>
        <entry>
          <string>iverilogOptions</string>
          <string>-g2012</string>
        </entry>
      </elementAttributes>
      <pos x="-940" y="360"/>
    </visualElement>
    <visualElement>
      <elementName>External</elementName>
      <elementAttributes>
        <entry>
          <string>applicationType</string>
          <appType>IVERILOG</appType>
        </entry>
        <entry>
          <string>Label</string>
          <string>loadext</string>
        </entry>
        <entry>
          <string>externalInputs</string>
          <string>funct3:3,addr:2,mem_data:32</string>
        </entry>
        <entry>
          <string>Width</string>
          <int>8</int>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>read_data:32</string>
        </entry>
        <entry>
          <string>Code</string>
          <string>module loadext (
  input  logic [2:0]  funct3,      // 000: lb, 001: lh, 010: lw, 100: lbu, 101: lhu
  input  logic [1:0]  addr,        // dos bits bajos de la dirección
  input  logic [31:0] mem_data,
  output logic [31:0] read_data
);

  logic [7:0]  byte_sel;
  logic [15:0] half_sel;

  assign byte_sel = mem_data[8*addr +: 8];
  assign half_sel = addr[1] ? mem_data[31:16] : mem_data[15:0];   // addr[0] se ignora

  always_comb begin
    case (funct3)
      3&apos;b000:  read_data = {{24{byte_sel[7]}},  byte_sel};   // lb
      3&apos;b001:  read_data = {{16{half_sel[15]}}, half_sel};   // lh
      3&apos;b100:  read_data = {24&apos;b0, byte_sel};                // lbu
      3&apos;b101:  read_data = {16&apos;b0, half_sel};                // lhu
      default: read_data = mem_data;                         // lw
    endcase
  end
endmodule</string>
        </entry>
