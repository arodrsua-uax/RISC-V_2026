        <entry>
          <string>Code</string>
          <string>module extend (
    input  logic [31:0] instr,
    output logic [31:0] immext
);

  always_comb begin
    case (instr[6:0])
      7&apos;b0010011, 7&apos;b0000011, 7&apos;b1100111:
        immext = {{20{instr[31]}}, instr[31:20]};                                           // I
      7&apos;b0100011:
        immext = {{20{instr[31]}}, instr[31:25], instr[11:7]};                              // S
      7&apos;b1100011:
        immext = {{19{instr[31]}}, instr[31], instr[7], instr[30:25], instr[11:8], 1&apos;b0};   // B
      7&apos;b0110111, 7&apos;b0010111:
        immext = {instr[31:12], 12&apos;b0};                                                     // U
      7&apos;b1101111:
        immext = {{11{instr[31]}}, instr[31], instr[19:12], instr[20], instr[30:21], 1&apos;b0}; // J
      default:
        immext = &apos;0;
    endcase
  end
endmodule</string>
        </entry>
        <entry>
          <string>iverilogOptions</string>
          <string>-g2012</string>
        </entry>
      </elementAttributes>
      <pos x="-1740" y="480"/>
    </visualElement>
    <visualElement>
      <elementName>External</elementName>
      <elementAttributes>
        <entry>
          <string>applicationType</string>
          <appType>IVERILOG</appType>
        </entry>
        <entry>
          <string>Label</string>
          <string>alu</string>
        </entry>
        <entry>
          <string>externalInputs</string>
          <string>alucontrol:4,a:32,b:32</string>
        </entry>
        <entry>
          <string>Width</string>
          <int>8</int>
        </entry>
        <entry>
          <string>externalOutputs</string>
          <string>zero,result:32</string>
        </entry>
        <entry>
          <string>Code</string>
          <string>module alu_shifter (
    input  logic [31:0] a,
    input  logic [4:0]  shamt,
    input  logic [3:0]  alucontrol,
    output logic [31:0] y
);

  always_comb begin
    case (alucontrol)
      4&apos;b1001: y = a &lt;&lt; shamt;            // SLL
      4&apos;b1010: y = a &gt;&gt; shamt;            // SRL
      4&apos;b1011: y = $signed(a) &gt;&gt;&gt; shamt;  // SRA
      default: y = 32&apos;h0;
    endcase
  end

endmodule

// ---------------------------------------------------------------------
// Comparador: SLT, SLTU
// ---------------------------------------------------------------------
module alu_cmp (
    input  logic [31:0] a,
    input  logic [31:0] b,
    input  logic [3:0]  alucontrol,
    output logic [31:0] y
);

  always_comb begin
    case (alucontrol)
      4&apos;b0101: y = {31&apos;b0, $signed(a) &lt; $signed(b)};  // SLT
      4&apos;b1100: y = {31&apos;b0, a &lt; b};                    // SLTU
      default: y = 32&apos;h0;
    endcase
  end

endmodule

// ---------------------------------------------------------------------
// ALU: el case solo selecciona el resultado
// ---------------------------------------------------------------------
module alu (
    input  logic [31:0] a,
    input  logic [31:0] b,
    input  logic [3:0]  alucontrol,
    output logic [31:0] result,
    output logic        zero
);

  logic [31:0] shift_res, cmp_res;

  alu_shifter u_shifter (
      .a         (a),
      .shamt     (b[4:0]),
      .alucontrol(alucontrol),
      .y         (shift_res)   // salida del módulo de desplazamiento
  );

  alu_cmp u_cmp (
      .a         (a),
      .b         (b),
      .alucontrol(alucontrol),
      .y         (cmp_res)    // salida del módulo de comparación
  );

  always_comb begin
    case (alucontrol)

      4&apos;b0000: result = a + b;            // ADD
      4&apos;b0001: result = a - b;            // SUB
      4&apos;b0010: result = a &amp; b;            // AND
      4&apos;b0011: result = a | b;            // OR
      4&apos;b1000: result = a ^ b;            // XOR

      4&apos;b0101,                            // SLT
      4&apos;b1100: result = cmp_res;          // SLTU Salida del módulo de comparación

      4&apos;b1001,                            // SLL
      4&apos;b1010,                            // SRL
      4&apos;b1011: result = shift_res;        // SRA  Salida del módulo de desplazamiento

      default: result = 32&apos;hDEADBEEF;     // valor por defecto para depuración
    endcase
  end

  assign zero = (result == 32&apos;h0);

endmodule</string>
        </entry>
        <entry>
